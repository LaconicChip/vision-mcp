{
  // =============================================================
  // vision-mcp 配置（JSONC：支持 // 和 # 注释，保存后自动热重载）
  // 复制/编辑 config.json 后填写你的 API Key。
  // =============================================================

  // ---- 默认提示词（可改）------------------------------------------
  "default_prompt": "请详细描述这张图片的内容，包括画面中的文字、物体、界面元素、数据、代码和可能的含义。如果这是截图，请重点提取其中的关键信息。",

  // ---- 路由顺序 ----------------------------------------------------
  // 1) race：免费竞速池，多个模型并发，首个有效结果获胜
  // 2) fallback：免费竞速池全部失败/超时后，自动降级到用户自定义保底模型
  "routing": {
    "race": [
      "glm",               // glm-4v-flash
      "glm-thinking",      // glm-4.1v-thinking-flash
      "glm-4.6v-flash",    // glm-4.6v-flash（⚠️ 不稳定，可能限流/慢）
      "agnes-2.5-flash",   // agnes-2.5-flash
      "agnes-2.0-flash"    // agnes-2.0-flash
    ],
    "fallback": [
      "custom-1"           // ← 用户自定义保底多模态模型（免费池全失败时自动降级）
    ]
  },

  // ---- 免费竞速池通道：每个都是 OpenAI 兼容 chat/completions ------
  // api_key（字面量）优先；没填则用 api_key_env 指向的环境变量。
  "channels": [
    {
      "id": "glm",
      "provider": "zhipu",
      "base_url": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
      "model": "glm-4v-flash",
      "api_key": "",                          // ← 智谱 Key（GLM_API_KEY）
      "api_key_env": "GLM_API_KEY",
      "timeout_ms": 90000,
      "max_tokens": 2048
    },
    {
      "id": "glm-thinking",
      "provider": "zhipu",
      "base_url": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
      "model": "glm-4.1v-thinking-flash",
      "api_key": "",                          // 与 glm 同一个智谱 Key
      "api_key_env": "GLM_API_KEY",
      "timeout_ms": 90000,
      "max_tokens": 2048
    },
    {
      "id": "glm-4.6v-flash",
      "provider": "zhipu",
      "base_url": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
      "model": "glm-4.6v-flash",
      "api_key": "",                          // 与 glm 同一个智谱 Key
      "api_key_env": "GLM_API_KEY",
      "timeout_ms": 120000,
      "max_tokens": 2048,
      "note": "glm-4.6v-flash 可用但不稳定：可能 429 限流或响应很慢（实测约 24s），保留作补充"
    },
    {
      "id": "agnes-2.5-flash",
      "provider": "agnes",
      "base_url": "https://apihub.agnes-ai.com/v1/chat/completions",
      "model": "agnes-2.5-flash",
      "api_key": "",                          // ← Agnes Key（AGNES_API_KEY）
      "api_key_env": "AGNES_API_KEY",
      "timeout_ms": 90000,
      "max_tokens": 2048
    },
    {
      "id": "agnes-2.0-flash",
      "provider": "agnes",
      "base_url": "https://apihub.agnes-ai.com/v1/chat/completions",
      "model": "agnes-2.0-flash",
      "api_key": "",                          // 与 agnes-2.5-flash 同一个 key
      "api_key_env": "AGNES_API_KEY",
      "timeout_ms": 90000,
      "max_tokens": 2048
    },

    // ---- 用户自定义保底通道（免费竞速池全部失败后自动降级到这里）----
    // 自行填写你的多模态模型地址、模型名和 key；也可从环境变量读取。
    {
      "id": "custom-1",
      "provider": "custom",
      "base_url": "",                          // ← 你的保底多模态模型 chat/completions 地址
      "model": "",                             // ← 你的保底模型名
      "api_key": "",                           // ← 你的保底模型 key（或留空用下面环境变量）
      "api_key_env": "VISION_CUSTOM_API_KEY",
      "timeout_ms": 120000,
      "max_tokens": 4096
    }
  ],

  // 限额：单图大小、超时、默认 max_tokens
  "limits": {
    "max_file_bytes": 15728640,   // 15 MB
    "timeout_ms": 90000,
    "max_tokens": 1024
  },

  // 缓存：按图片内容哈希缓存结果，避免重复调用
  "storage": {
    "cache_enabled": true,
    "cache_dir": "~/.cache/vision-mcp",
    "cache_ttl_seconds": 604800   // 7 天
  },

  // OCR（可选）：纯文字提取时兜底（系统原生，本地离线，不上云）
  "ocr": {
    "system": {
      "enabled": true,
      "languages": "zh-Hans,en-US"
    }
  },

  // 文档解析（可选）：PDF/Word/PPT 走 MinerU
  "document": {
    "mineru": {
      "enabled": false,
      "command": "mineru-open-api",
      "mode": "flash"
    }
  }
}
